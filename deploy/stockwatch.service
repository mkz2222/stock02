[Unit]
Description=Stock and crypto price alerts
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=stockwatch
Group=stockwatch
WorkingDirectory=/opt/stockwatch
EnvironmentFile=/etc/stockwatch.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/stockwatch/monitor.py --rules /etc/stockwatch/watchlist.md --db /var/lib/stockwatch/monitor.sqlite3
StateDirectory=stockwatch
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
